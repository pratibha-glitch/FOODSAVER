# SmartPlate AI - Environment Configuration Example
# Copy this file to .env and customize values for your deployment

# Application Secret Key
SECRET_KEY=smartplate-campus-secret-key-2026-sdg2

# Database Configuration
DATABASE_PATH=smartplate.db

# Upload Folder Path
UPLOAD_FOLDER=static/uploads

# Vision AI Configuration (Google Gemini Vision)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Operational Deadlines (in hours) - Used for logistics planning (Not food safety certification)
DEADLINE_HOT_HOLDING_HOURS=3.0
DEADLINE_AMBIENT_DRY_HOURS=4.0
DEADLINE_AMBIENT_WET_HOURS=2.5
DEADLINE_DAIRY_HOURS=2.0
DEADLINE_CHILLED_HOURS=8.0
